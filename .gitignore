# Dependencies
node_modules/

# OS
.DS_Store

# Env / secrets
.env
.env.*
!.env.example

# Embedded Python runtime (edge_tts + mutagen for TTS)
python/

# Persistent Chrome profile used by the Gemini automation scripts (contains login session)
.chrome_profile/

# Douyin reup runtime state (per-machine, not source)
storage/
tiktok_browser_profile/

# Remotion render output
my-video-engine/output/
my-video-engine/dist/
my-video-engine/out/

# Generated TTS audio + AI-generated media (large binaries, regenerated by the pipeline)
my-video-engine/public/audio/*.mp3
my-video-engine/public/audio/*_words.json
my-video-engine/public/media/*
