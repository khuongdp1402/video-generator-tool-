# Copy this file to .env and fill in your own values. Never commit .env.

# AGENT API (https://agentgw.cloud) — primary LLM gateway for US/JP/VI script generation & scoring
AGENTGW_API_KEY=ag_live_your_api_key_here
AGENTGW_BASE_URL=https://agentgw.cloud/v1
AGENTGW_MODEL=agentgw-opus-4-8

# Google AI Studio key (https://aistudio.google.com/apikey) — optional fallback
GEMINI_API_KEY=

# YouTube Data API v3 OAuth client (Google Cloud Console > APIs & Services > Credentials).
YOUTUBE_CLIENT_SECRETS_FILE=client_secrets.json
YOUTUBE_TOKEN_FILE=token.json
YOUTUBE_TOKEN_FILE_US=token_us.json
YOUTUBE_TOKEN_FILE_JP=token_jp.json

# TikTok Content Posting API (requires an approved app at developers.tiktok.com).
TIKTOK_ACCESS_TOKEN=
