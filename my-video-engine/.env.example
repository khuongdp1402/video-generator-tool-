# Copy this file to .env and fill in your own values. Never commit .env.

# Google AI Studio key (https://aistudio.google.com/apikey) — used by ai_generator.py.
# Separate from any Gemini Ultra chat subscription; billed per the Gemini API's own pricing.
GEMINI_API_KEY=

# YouTube Data API v3 OAuth client (Google Cloud Console > APIs & Services > Credentials).
YOUTUBE_CLIENT_SECRETS_FILE=client_secrets.json
YOUTUBE_TOKEN_FILE=token.json

# TikTok Content Posting API (requires an approved app at developers.tiktok.com).
TIKTOK_ACCESS_TOKEN=
